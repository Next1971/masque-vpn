# frozen_string_literal: true

require "tmpdir"

default_platform(:ios)

APP_ID = "com.next1971.masque"
EXT_ID = "com.next1971.masque.packet-tunnel"

def provision_plist_field(path, field)
  tmp = File.join(Dir.tmpdir, "#{File.basename(path)}-#{field}.plist")
  system("security", "cms", "-D", "-i", path, "-o", tmp) or UI.user_error!("Could not decode #{path}")
  `/usr/libexec/PlistBuddy -c 'Print :#{field}' #{tmp}`.strip
end

platform :ios do
  desc "Sign, archive, and upload to TestFlight (GitHub Actions)"
  lane :beta do
    %w[
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_API_KEY
      APPLE_TEAM_ID
      P12_PASSWORD
    ].each do |k|
      UI.user_error!("Missing env #{k}") if ENV[k].to_s.empty?
    end

    cert = ENV.fetch("CERT_PATH")
    app_profile = ENV.fetch("APP_PROFILE_PATH")
    ext_profile = ENV.fetch("EXT_PROFILE_PATH")
    [cert, app_profile, ext_profile].each do |p|
      UI.user_error!("File not found: #{p}") unless File.file?(p)
    end

    setup_ci

    import_certificate(
      certificate_path: cert,
      certificate_password: ENV["P12_PASSWORD"],
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    install_provisioning_profile(path: app_profile)
    install_provisioning_profile(path: ext_profile)

    app_profile_name = provision_plist_field(app_profile, "Name")
    ext_profile_name = provision_plist_field(ext_profile, "Name")
    UI.message("App profile: #{app_profile_name}")
    UI.message("Extension profile: #{ext_profile_name}")

    team = ENV["APPLE_TEAM_ID"]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Masque.xcodeproj",
      targets: ["Masque"],
      team_id: team,
      code_sign_identity: "Apple Distribution",
      profile_name: app_profile_name,
      bundle_identifier: APP_ID
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Masque.xcodeproj",
      targets: ["PacketTunnel"],
      team_id: team,
      code_sign_identity: "Apple Distribution",
      profile_name: ext_profile_name,
      bundle_identifier: EXT_ID
    )

    build = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build,
      xcodeproj: "Masque.xcodeproj"
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    build_app(
      project: "Masque.xcodeproj",
      scheme: "Masque",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      clean: true,
      output_directory: "build",
      output_name: "Masque",
      export_team_id: team,
      export_options: {
        method: "app-store",
        teamID: team,
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          APP_ID => app_profile_name,
          EXT_ID => ext_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "GitHub Actions build #{build}"
    )
  end
end
