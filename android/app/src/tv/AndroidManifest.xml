<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV: touchscreen not required; leanback (D-pad) UI. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- Android 11+ package visibility: allow resolveActivity() to detect a
         file picker (ACTION_GET_CONTENT) so the app can gracefully fall back
         to paste-text when no file manager exists (e.g. Haier TV). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.Leanback">

        <activity
            android:name=".TvMainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Appears in the Android TV launcher row. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
