<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/tv_background"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MASQUE VPN"
        android:textColor="@color/tv_text_primary"
        android:textSize="40sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v—"
        android:textColor="@color/tv_text_secondary"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: —"
        android:textColor="@color/tv_text_secondary"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ping: —"
        android:textColor="@color/tv_text_secondary"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvTraffic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today: 0.0 MB\nMonth: 0.0 MB"
        android:textColor="@color/tv_text_secondary"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/tvBtnPaste"
        style="@style/TvButton"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:text="Import profile (paste text)"
        android:textSize="20sp"
        android:nextFocusDown="@+id/tvBtnClipboard"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/tvBtnClipboard"
        style="@style/TvButton"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:text="Paste config from clipboard"
        android:textSize="20sp"
        android:nextFocusUp="@+id/tvBtnPaste"
        android:nextFocusDown="@+id/tvBtnConnect"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/tvBtnConnect"
        style="@style/TvButton"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:text="Connect"
        android:textSize="22sp"
        android:textStyle="bold"
        android:nextFocusUp="@+id/tvBtnClipboard"
        android:nextFocusDown="@+id/tvBtnSettings"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/tvBtnSettings"
        style="@style/TvButton"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="20sp"
        android:nextFocusUp="@+id/tvBtnConnect" />

</LinearLayout>
