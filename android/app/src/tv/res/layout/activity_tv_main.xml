<?xml version="1.0" encoding="utf-8"?>
<!--
  Android TV lays out at 960×540dp. v1.7.1 fitted Connect as the third control.
  v2.1.0 added two traffic lines plus Settings and pushed Connect under the
  panel on some TVs. Connect is first; the column must stay under ~460dp
  so the last button remains inside the 5% overscan margin. ScrollView is only
  the fallback when a long status or a large font still overflows.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:background="@color/tv_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MASQUE VPN"
            android:textColor="@color/tv_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v—"
            android:textColor="@color/tv_text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: —"
            android:textColor="@color/tv_text_secondary"
            android:textSize="18sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvPing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ping: —"
            android:textColor="@color/tv_text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvTraffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today: 0.0 MB\nMonth: 0.0 MB"
            android:textColor="@color/tv_text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:maxLines="2"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/tvBtnConnect"
            style="@style/TvScreenButton.Primary"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:text="Connect"
            android:nextFocusDown="@+id/tvBtnClipboard"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/tvBtnClipboard"
            style="@style/TvScreenButton"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:text="Paste config from clipboard"
            android:nextFocusUp="@+id/tvBtnConnect"
            android:nextFocusDown="@+id/tvBtnPaste"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/tvBtnPaste"
            style="@style/TvScreenButton"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:text="Import profile (paste text)"
            android:nextFocusUp="@+id/tvBtnClipboard"
            android:nextFocusDown="@+id/tvBtnSettings"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/tvBtnSettings"
            style="@style/TvScreenButton"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:nextFocusUp="@+id/tvBtnPaste" />

    </LinearLayout>
</ScrollView>
