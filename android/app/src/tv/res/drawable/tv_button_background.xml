<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_focus_bg" />
            <stroke
                android:width="4dp"
                android:color="@color/tv_button_focus_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_pressed_bg" />
            <stroke
                android:width="3dp"
                android:color="@color/tv_button_focus_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_button_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
