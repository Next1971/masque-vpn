# Aggregate ignore rules (see per-directory .gitignore files too).

# Secrets — NEVER commit
*.key
*.keystore
*.jks
keystore.properties
keystore-credentials.txt
**/certs/*.crt
**/certs/*.pem
_signing/
_artifacts/

# Generator output (contains private keys)
server/scripts/out/
out/
ca.srl

# Real client profiles (distribute out-of-band)
profile.client.toml
**/uploaded_profile.toml

# Locally built Linux server binaries (attach to a GitHub Release, do not commit)
dist-server/
/vpn-server

# Build output
build/
.gradle/
android/app/build/
android/local.properties
android/app/libs/masque.aar
android/app/libs/masque-sources.jar
dist/
*.exe
*.dll
*.aar
*.so

# Go
*.test
*.out

# OS / editor
.idea/
.vscode/
.DS_Store
Thumbs.db

# iOS / Xcode
ios/Frameworks/*.xcframework
ios/Frameworks/*.framework
**/xcuserdata/
*.xcuserstate
DerivedData/
*.p12
*.p8
*.cer
*.csr
*.mobileprovision
ios/signing-local/
ios/build-signing/
ios/build/
