[Unit]
Description=MASQUE VPN server (CONNECT-IP/QUIC, mTLS)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/masque
# Enable IP forwarding and NAT so client traffic reaches the internet.
# Replace "eth0" with your server's public network interface (check: ip route get 1.1.1.1).
# Replace "10.8.0.0/24" if you changed pool_cidr in the config.
ExecStartPre=/sbin/sysctl -w net.ipv4.ip_forward=1
ExecStartPre=/sbin/sysctl -w net.ipv6.conf.all.forwarding=1
# QUIC needs large UDP socket buffers; stock Linux rmem_max/wmem_max (~208 KiB) drops packets.
ExecStartPre=/sbin/sysctl -w net.core.rmem_max=67108864
ExecStartPre=/sbin/sysctl -w net.core.wmem_max=67108864
ExecStartPre=/bin/sh -c 'iptables -t nat -C POSTROUTING -s 10.8.0.0/24 -o eth0 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o eth0 -j MASQUERADE'
ExecStartPre=/bin/sh -c 'ip6tables -t nat -C POSTROUTING -s fd00:8::/64 -o eth0 -j MASQUERADE 2>/dev/null || ip6tables -t nat -A POSTROUTING -s fd00:8::/64 -o eth0 -j MASQUERADE || true'
ExecStart=/opt/masque/vpn-server -config /opt/masque/config.server.toml
User=root
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
DeviceAllow=/dev/net/tun rw
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
